# Copy this file to .env.local and fill it in. .env.local is never committed.

# Public site URL (canonical URLs, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://sunconwest.com

# ---- Where website enquiries are delivered ----
MAIL_TO=hr@sunconwest.com

# ---- Option 1: SMTP (recommended: any mailbox works) ----
# Gmail:        host smtp.gmail.com, port 587, user = full Gmail address, pass = a 16-character App Password
# Microsoft 365: host smtp.office365.com, port 587
# Domain host:  use the outgoing mail server shown in your hosting panel
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: shown as the sender, e.g. "Suncon West Website <hr@sunconwest.com>" (must be allowed by your mail provider)
MAIL_FROM=

# ---- Option 2: Resend (https://resend.com), only if you do not use SMTP ----
RESEND_API_KEY=
